# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
# MongoDB Atlas connection string (include database name if you want to override DB_NAME)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
CONNECTION_STRING=your_mongodb_atlas_connection_string_here

# Database name (optional - will default based on NODE_ENV if not provided)
# Development: finance-tracker-dev
# Staging: finance-tracker-staging
# Production: finance-tracker-prod
# Test: finance-tracker-test
DB_NAME=finance-tracker-dev

# Database credentials (optional if included in CONNECTION_STRING)
DB_USER=your_db_username
DB_USER_PASSWORD=your_db_password

# JWT Configuration
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ENC_ALGO=HS256

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:8000,http://localhost:4200

# Logging Configuration
# Options: fatal, error, warn, info, debug, trace
# Development: debug
# Production: warn or error
LOG_LEVEL=info

# --- .env.staging (optional; same keys as above) ---
# Staging: npm run docker:staging runs Compose with --env-file .env.staging so
# docker-compose.staging.yml can fill ${CONNECTION_STRING}, ${SECRET_KEY}, etc.
# Or omit .env.staging and run `docker compose -f docker-compose.staging.yml up`
# from the repo root — Compose will use project .env for ${…} interpolation.
