{
  "name": "finance-tracker",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "docker:build": "docker build -t finance-tracker .",
    "docker:dev": "docker compose up finance-tracker-dev",
    "docker:staging": "docker compose -f docker-compose.staging.yml --env-file .env.staging up finance-tracker-staging",
    "docker:staging:down": "docker compose -f docker-compose.staging.yml down",
    "docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.0.1",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.2.3",
    "tsx": "^4.21.0",
    "zod": "^4.3.4",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^1.6.1"
  }
}
